<!-- ESTILOS COMPARTIDOS DE AUTENTICACIÓN -->
<style>
  /* Botones de Cabecera Superior */
  .auth-buttons-container {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-auth {
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }

  /* El botón "Ingresar" comparte la estética del botón de compartir */
  .btn-login {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .btn-login:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* El botón "Registrar" utiliza el naranja/coral secundario de la marca */
  .btn-register {
    background-color: #e75b37; /* Naranja toc.ar */
    color: #ffffff;
    border: none;
  }

  .btn-register:hover {
    background-color: #d04a26;
  }

  /* ESTILOS DEL MODAL DE REGISTRO */
  .auth-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }

  .auth-modal {
    background-color: #ffffff;
    border-radius: 16px;
    width: 90%;
    max-width: 420px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    position: relative;
    text-align: center;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    animation: fadeInModal 0.3s ease;
  }

  @keyframes fadeInModal {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .auth-modal-close {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 1.3rem;
    color: #a0aec0;
    cursor: pointer;
    background: none;
    border: none;
  }

  .auth-modal-close:hover {
    color: #4a5568;
  }

  .auth-modal-logo {
    width: 50px;
    height: 50px;
    margin-bottom: 15px;
  }

  .auth-modal-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0d4b75; /* Azul toc.ar */
    margin-bottom: 8px;
  }

  .auth-modal-subtitle {
    font-size: 0.95rem;
    color: #718096;
    margin-bottom: 25px;
    line-height: 1.4;
  }

  .auth-modal-legend {
    font-size: 0.85rem;
    font-weight: bold;
    color: #4a5568;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 15px;
  }

  /* Botones de login social del modal */
  .modal-social-btn-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .modal-btn-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px;
    border-radius: 8px;
    font-weight: bold;
    text-decoration: none;
    font-size: 0.95rem;
    cursor: pointer;
    border: none;
    transition: opacity 0.2s;
    width: 100%;
  }

  .modal-btn-google {
    background-color: #ffffff;
    color: #2d3748;
    border: 1px solid #cbd5e0;
  }

  .modal-btn-meta {
    background-color: #1877f2;
    color: #ffffff;
  }

  .modal-btn-social:hover {
    opacity: 0.9;
  }

  /* MENÚ DESPLEGABLE DE USUARIO LOGUEADO */
  .auth-user-menu-container {
    position: relative;
  }

  .btn-user-menu {
    background-color: #e75b37; /* Naranja */
    color: white;
    border: none;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
  }

  .btn-user-menu:hover {
    background-color: #d04a26;
  }

  .user-dropdown-menu {
    display: none;
    position: absolute;
    top: 50px;
    right: 0;
    background-color: #ffffff;
    border: 1px solid #4a5568;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    z-index: 10000;
    min-width: 180px;
    overflow: hidden;
  }

  .user-dropdown-menu.show {
    display: block;
  }

  .user-dropdown-item {
    display: block;
    padding: 12px 20px;
    color: #2d3748;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-bottom: 1px solid #edf2f7;
    text-align: left;
    transition: background-color 0.2s, color 0.2s;
  }

  .user-dropdown-item:last-child {
    border-bottom: none;
  }

  .user-dropdown-item:hover {
    background-color: #f7fafc;
    color: #0d4b75;
  }
</style>

<!-- RENDERIZADO DINÁMICO DE BOTONES SEGÚN SESIÓN -->
<div class="auth-wrapper-container">
  <% if (currentUser) { %>
    <!-- USUARIO LOGUEADO: Botón Menú -->
    <div class="auth-user-menu-container">
      <button class="btn-user-menu" onclick="toggleUserAuthMenu(event)" title="Menú de Usuario">
        <i class="fa-solid fa-bars"></i>
      </button>
      <div class="user-dropdown-menu" id="userAuthDropdown">
        <!-- REEMPLAZALA POR ESTA: -->
		<a href="http://quienva.toc.ar:3000/" class="user-dropdown-item">¿Quién va a tocar?</a>
        <a href="#" class="user-dropdown-item" onclick="triggerAuthAlert('Perfil')">Perfil</a>
        <a href="#" class="user-dropdown-item" onclick="triggerAuthAlert('Mensajes')">Mensajes</a>
        <a href="/auth/logout" class="user-dropdown-item">Salir</a>
      </div>
    </div>
  <% } else { %>
    <!-- USUARIO NO LOGUEADO: Botones de Ingreso / Registro -->
    <div class="auth-buttons-container">
      <button class="btn-auth btn-login" onclick="openAuthModal()">Ingresar</button>
      <button class="btn-auth btn-register" onclick="openAuthModal()">Registrar</button>
    </div>
  <% } %>
</div>

<!-- MODAL DE REGISTRO E INGRESO COMPARTIDO -->
<div class="auth-modal-overlay" id="authModalOverlay" onclick="closeAuthModalOnOutsideClick(event)">
  <div class="auth-modal">
    <button class="auth-modal-close" onclick="closeAuthModal()"><i class="fa-solid fa-xmark"></i></button>
    
    <img src="/images/toc-ar-logo-azul.png" class="auth-modal-logo" alt="toc.ar logo">
    <h2 class="auth-modal-title">¿Registrarme en quién va a tocar?</h2>
    <p class="auth-modal-subtitle">Para disfrutar al máximo de tus artistas favoritos.</p>
    
    <div class="auth-modal-legend">Regístrate o inicia sesión:</div>
    
    <div class="modal-social-btn-group">
      <!-- Los redireccionamientos pasan por Passport -->
      <!-- Botón de Google Corregido con SVG Integrado -->
      <a href="/auth/google" class="modal-btn-social modal-btn-google">
        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="18px" height="18px" viewBox="0 0 48 48" style="display: block;">
          <g>
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
            <path fill="#4285F4" d="M46.5 24c0-1.61-.15-3.16-.42-4.69H24v8.89h12.66c-.55 2.92-2.2 5.39-4.69 7.05v5.86h7.59C44.1 36.32 46.5 30.73 46.5 24z"></path>
            <path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"></path>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.59-5.86c-2.1 1.41-4.76 2.25-8.3 2.25-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
          </g>
        </svg>
        Iniciar sesión con Google
      </a>
      <a href="/auth/facebook" class="modal-btn-social modal-btn-meta">
        <i class="fa-brands fa-facebook-f" style="font-size: 1.1rem;"></i>
        Iniciar sesión con Meta
      </a>
    </div>
  </div>
</div>

<script>
  // Control de Modal
  function openAuthModal() {
    document.getElementById('authModalOverlay').style.display = 'flex';
  }

  function closeAuthModal() {
    document.getElementById('authModalOverlay').style.display = 'none';
  }

  function closeAuthModalOnOutsideClick(event) {
    if (event.target === document.getElementById('authModalOverlay')) {
      closeAuthModal();
    }
  }

  // Control de Menú de Usuario
  function toggleUserAuthMenu(event) {
    event.stopPropagation();
    const menu = document.getElementById('userAuthDropdown');
    if (menu) {
      menu.classList.toggle('show');
    }
  }

  // Cierre de menús al hacer clic fuera
  window.addEventListener('click', function(event) {
    const dropdown = document.getElementById('userAuthDropdown');
    if (dropdown && dropdown.classList.contains('show')) {
      dropdown.classList.remove('show');
    }
  });

  function triggerAuthAlert(optionName) {
    alert(`Presionaste la opción "${optionName}". Esta funcionalidad se implementará pronto.`);
  }
</script>