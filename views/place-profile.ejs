<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= lugar.nombre %> - toc.ar</title>
  <!-- FontAwesome para los íconos de servicios y estrellas -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    /* Inyección dinámica de la paleta de colores igual que en Artistas */
    :root {
      --primary-color: <%= lugar.theme.primaryColor %>;
      --secondary-color: <%= lugar.theme.secondaryColor %>;
      --background-color: <%= lugar.theme.backgroundColor %>;
      --text-color: <%= lugar.theme.textColor %>;
    }

    body {
      font-family: '<%= lugar.personalizacion?.tipoLetra || "Arial" %>', sans-serif;
      background-color: var(--background-color);
      color: var(--text-color);
      margin: 0;
      padding: 0;
    }

    /* Banner Superior */
    .hero-banner {
      width: 100%;
      height: 350px;
      background: url('<%= lugar.banner %>') center/cover no-repeat;
      position: relative;
    }

    .hero-overlay {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.8));
      display: flex;
      align-items: flex-end;
      padding: 40px;
      box-sizing: border-box;
    }

    .header-container {
      display: flex;
      align-items: center;
      gap: 30px;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .profile-logo {
      width: 130px;
      height: 130px;
      border-radius: 50%;
      border: 4px solid var(--primary-color);
      object-fit: cover;
      background: #fff;
    }

    .profile-info h1 {
      margin: 0 0 10px 0;
      font-size: 36px;
      color: #ffffff;
    }

    .rating-badge {
      color: #f1c40f;
      font-size: 18px;
    }

    .rating-badge span {
      color: #ffffff;
      font-size: 14px;
      margin-left: 5px;
    }

    /* Contenedor de Contenido */
    .main-content {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 40px;
    }

    @media (max-width: 768px) {
      .main-content { grid-template-columns: 1fr; }
      .header-container { flex-direction: column; text-align: center; }
    }

    .section-title {
      font-size: 24px;
      border-bottom: 3px solid var(--primary-color);
      padding-bottom: 8px;
      margin-bottom: 25px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* 🛠️ Nueva Sección: Servicios e Infraestructura Gráfica */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 15px;
      margin-bottom: 40px;
    }

    .service-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 10px;
      padding: 20px 10px;
      text-align: center;
      transition: transform 0.2s, border-color 0.2s;
    }

    .service-card:hover {
      transform: translateY(-3px);
      border-color: var(--secondary-color);
    }

    .service-card i {
      font-size: 28px;
      color: var(--primary-color);
      margin-bottom: 12px;
    }

    .service-card.active i {
      color: var(--secondary-color);
    }

    .service-name {
      font-size: 12px;
      font-weight: bold;
      display: block;
      margin-bottom: 4px;
    }

    .service-status {
      font-size: 11px;
      color: #888;
    }

    /* Lista de Eventos (Agenda) */
    .event-card {
      background: rgba(255, 255, 255, 0.03);
      border-left: 5px solid var(--primary-color);
      border-radius: 4px;
      padding: 20px;
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .event-card.sponsored {
      border-left-color: var(--secondary-color);
      background: linear-gradient(to right, rgba(231, 91, 55, 0.05), transparent);
    }

    .event-details h3 { margin: 0 0 5px 0; font-size: 18px; }
    .event-details p { margin: 0; font-size: 14px; color: #777; }

    .btn-tickets {
      background-color: var(--secondary-color);
      color: #fff;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 4px;
      font-weight: bold;
      font-size: 14px;
    }

    /* 💬 Sección: Reseñas Históricas de Eventos */
    .review-item {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(0,0,0,0.05);
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 15px;
    }

    .review-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 13px;
    }

    .review-user { font-weight: bold; }
    .review-stars { color: #f1c40f; }
    .review-comment { font-size: 14px; line-height: 1.4; color: #555; }
    body[style*="background-color: #121212"] .review-comment { color: #bbb; } /* Adaptación modo oscuro */

    /* Lateral Informativo */
    .sidebar-box {
      background: rgba(255, 255, 255, 0.04);
      padding: 25px;
      border-radius: 8px;
      margin-bottom: 25px;
    }

    .info-list { list-style: none; padding: 0; margin: 0; }
    .info-list li { margin-bottom: 15px; font-size: 14px; display: flex; gap: 10px; }
    .info-list i { color: var(--primary-color); width: 20px; text-align: center; }
  </style>
</head>
<body>

  <!-- Encabezado con Imagen Widescreen OBLIGATORIA -->
  <header class="hero-banner">
    <div class="hero-overlay">
      <div class="header-container">
        <img class="profile-logo" src="<%= lugar.logo || 'https://placehold.co/130x130?text=toc.ar' %>" alt="Logo de <%= lugar.nombre %>">
        <div class="profile-info">
          <h1><%= lugar.nombre %></h1>
          <div class="rating-badge">
            <% for(let i=1; i<=5; i++) { %>
              <i class="<%= i <= Math.round(averageRating) ? 'fas' : 'far' %> fa-star"></i>
            <% } %>
            <span><%= averageRating.toFixed(1) %> (<%= lugar.votes || 0 %> opiniones)</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="main-content">
    
    <!-- Bloque Izquierdo Principal -->
    <section>
      <!-- 🛠️ SECCIÓN REQUERIDA: SERVICIOS GRÁFICOS MEDIANTE ÍCONOS -->
      <h2 class="section-title"><i class="fas fa-layer-group"></i> Infraestructura y Servicios</h2>
      <div class="services-grid">
        
        <!-- Capacidad -->
        <div class="service-card active">
          <i class="fas fa-users"></i>
          <span class="service-name">Capacidad Máx</span>
          <span class="service-status"><%= lugar.capacidad?.espectadoresMax || 'No especificado' %> pers.</span>
        </div>

        <!-- Estacionamiento -->
        <div class="service-card <%= lugar.capacidad?.estacionamientoPropio === 'SI' ? 'active' : '' %>">
          <i class="fas fa-car"></i>
          <span class="service-name">Estacionamiento</span>
          <span class="service-status"><%= lugar.capacidad?.estacionamientoPropio || 'NO' %></span>
        </div>

        <!-- Escenario -->
        <div class="service-card <%= lugar.infraestructuraTecnica?.escenario === 'SI' ? 'active' : '' %>">
          <i class="fas fa-guitar"></i>
          <span class="service-name">Escenario Fijo</span>
          <span class="service-status"><%= lugar.infraestructuraTecnica?.escenario || 'NO' %></span>
        </div>

        <!-- Sonido Instalado -->
        <div class="service-card <%= lugar.infraestructuraTecnica?.sonido === 'SI' ? 'active' : '' %>">
          <i class="fas fa-volume-high"></i>
          <span class="service-name">Sonido Fijo (PA)</span>
          <span class="service-status"><%= lugar.infraestructuraTecnica?.sonido || 'NO' %></span>
        </div>

        <!-- Iluminación -->
        <div class="service-card <%= lugar.infraestructuraTecnica?.iluminacion === 'SI' ? 'active' : '' %>">
          <i class="fas fa-lightbulb"></i>
          <span class="service-name">Iluminación</span>
          <span class="service-status"><%= lugar.infraestructuraTecnica?.iluminacion || 'NO' %></span>
        </div>

        <!-- Reserva de Mesas -->
        <div class="service-card <%= lugar.capacidad?.reservaMesas ? 'active' : '' %>">
          <i class="fas fa-chair"></i>
          <span class="service-name">Reserva de Mesas</span>
          <span class="service-status"><%= lugar.capacidad?.reservaMesas ? 'DISPONIBLE' : 'NO' %></span>
        </div>

        <!-- Comida -->
        <div class="service-card <%= lugar.infraestructuraTecnica?.ventaComida === 'SI' ? 'active' : '' %>">
          <i class="fas fa-utensils"></i>
          <span class="service-name">Venta de Comida</span>
          <span class="service-status"><%= lugar.infraestructuraTecnica?.ventaComida || 'NO' %></span>
        </div>

        <!-- Bebida -->
        <div class="service-card <%= lugar.infraestructuraTecnica?.ventaBebidas === 'SI' ? 'active' : '' %>">
          <i class="fas fa-beer-mug-empty"></i>
          <span class="service-name">Venta de Bebidas</span>
          <span class="service-status"><%= lugar.infraestructuraTecnica?.ventaBebidas || 'NO' %></span>
        </div>

        <!-- Entorno / Condición -->
        <div class="service-card active">
          <i class="fas fa-cloud-sun"></i>
          <span class="service-name">Espacio</span>
          <span class="service-status">
            <%= lugar.tipoEspecifico?.includes('Aire Libre') || lugar.nombre?.includes('Patio') || lugar.nombre?.includes('Anfiteatro') ? 'Al Aire Libre' : 'Techado / Mixto' %>
          </span>
        </div>
      </div>

      <!-- Próximos Eventos Programados -->
      <h2 class="section-title"><i class="fas fa-calendar-days"></i> Próximas Fechas en este Lugar</h2>
      <div class="events-list">
        <% if (eventos && eventos.length > 0) { %>
          <% eventos.forEach(evento => { %>
            <div class="event-card <%= evento.isSponsored ? 'sponsored' : '' %>">
              <div class="event-details">
                <h3><%= evento.nombre %></h3>
                <p><i class="fas fa-music"></i> Artista: <strong><%= evento.artista?.nombre %></strong></p>
                <p><i class="far fa-clock"></i> <%= new Date(evento.fechaInicio).toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'short', hour: '2-digit', minute:'2-digit' }) %> hs</p>
                <p><i class="fas fa-ticket"></i> Acceso: <%= evento.modalidadAcceso %> <%= evento.precioEntrada > 0 ? `($${evento.precioEntrada})` : '' %></p>
              </div>
              <div>
                <a href="<%= evento.modalidadAcceso === 'Link Externo' ? evento.linkExternoVenta : '#' %>" class="btn-tickets">
                  <%= evento.modalidadAcceso === 'Paga Interna' ? 'Comprar' : 'Asistir' %>
                </a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color: #888; font-style: italic;">No hay eventos programados en este momento para este establecimiento.</p>
        <% } %>
      </div>

      <!-- 💬 SECCIÓN REQUERIDA: RESEÑAS HISTÓRICAS DE EVENTOS ASISTIDOS -->
      <h2 class="section-title"><i class="fas fa-comments"></i> Opiniones de la Comunidad</h2>
      <div class="reviews-list">
        <% if (reviews && reviews.length > 0) { %>
          <% reviews.forEach(rev => { %>
            <div class="review-item">
              <div class="review-header">
                <span class="review-user"><i class="far fa-user"></i> Espectador Anónimo</span>
                <span class="review-stars">
                  <% for(let i=1; i<=5; i++) { %>
                    <i class="<%= i <= rev.estrellas ? 'fas' : 'far' %> fa-star"></i>
                  <% } %>
                </span>
              </div>
              <p class="review-comment">"<%= rev.comentario %>"</p>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color: #888; font-style: italic;">Este establecimiento aún no registra opiniones escritas por espectadores verificados.</p>
        <% } %>
      </div>
    </section>

    <!-- Bloque Derecho (Sidebar Informativo) -->
    <aside>
      <div class="sidebar-box">
        <h3 style="margin-top: 0; font-size: 18px; border-bottom: 2px solid var(--primary-color); padding-bottom: 5px;">Detalles del Lugar</h3>
        <ul class="info-list">
          <li><i class="fas fa-building"></i> <span><strong>Categoría:</strong><br><%= lugar.tipoMacro %></span></li>
          <li><i class="fas fa-sliders"></i> <span><strong>Tipo:</strong><br><%= lugar.tipoEspecifico %></span></li>
          <li><i class="far fa-clock"></i> <span><strong>Horarios:</strong><br><%= lugar.diasHorarios %></span></li>
          <li><i class="fas fa-location-dot"></i> <span><strong>Ubicación:</strong><br>Alto Valle Región (Indexado en Mapa)</span></li>
        </ul>
      </div>

      <% if (lugar.redesSociales && Object.values(lugar.redesSociales).some(x => x)) { %>
        <div class="sidebar-box">
          <h3 style="margin-top: 0; font-size: 18px; border-bottom: 2px solid var(--primary-color); padding-bottom: 5px;">Contacto</h3>
          <div style="display: flex; gap: 15px; font-size: 20px; flex-wrap: wrap;">
            <% if (lugar.redesSociales.instagram) { %><a href="<%= lugar.redesSociales.instagram %>" style="color: var(--secondary-color);"><i class="fab fa-instagram"></i></a><% } %>
            <% if (lugar.redesSociales.facebook) { %><a href="<%= lugar.redesSociales.facebook %>" style="color: var(--secondary-color);"><i class="fab fa-facebook"></i></a><% } %>
            <% if (lugar.redesSociales.whatsapp) { %><a href="https://wa.me/<%= lugar.redesSociales.whatsapp %>" style="color: var(--secondary-color);"><i class="fab fa-whatsapp"></i></a><% } %>
            <% if (lugar.redesSociales.email) { %><a href="mailto:<%= lugar.redesSociales.email %>" style="color: var(--secondary-color);"><i class="far fa-envelope"></i></a><% } %>
          </div>
        </div>
      <% } %>
    </aside>

  </main>

</body>
</html>