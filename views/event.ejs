<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear Evento - toc.ar</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Carga segura de la API de Google Maps -->
  <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAnapFRmAdB3WalCY8uIrNlyeFLgE1lrpo&libraries=places"></script>

  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; }
    
    .form-container { max-width: 700px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
    
    .form-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid #334155; padding-bottom: 15px; }
    h2 { margin: 0; color: #38bdf8; display: flex; align-items: center; gap: 10px; font-size: 22px; }
    
    .btn-back {
      background: rgba(255,255,255,0.1); color: #f8fafc; text-decoration: none; padding: 8px 16px; border-radius: 6px;
      font-size: 14px; font-weight: bold; border: 1px solid #334155; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-back:hover { background: #334155; color: #38bdf8; }

    .form-group { margin-bottom: 20px; position: relative; }
    label { display: block; margin-bottom: 8px; font-weight: bold; color: #94a3b8; font-size: 14px; }
    input[type="text"], input[type="date"], input[type="number"], input[type="file"], select {
      width: 100%; padding: 12px; border: 1px solid #334155; border-radius: 6px; background: #0f172a; color: #fff; box-sizing: border-box; font-size: 14px;
    }

    .suggestions-list {
      position: absolute; top: 100%; left: 0; right: 0; background: #1e293b; border: 1px solid #334155; border-radius: 0 0 6px 6px; z-index: 10; max-height: 200px; overflow-y: auto;
    }
    .suggestion-item { padding: 10px; cursor: pointer; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #334155; }
    .suggestion-item:hover { background: #334155; }
    
    .artists-list { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
    .artist-card {
      background: #0f172a; border: 1px solid #38bdf8; border-radius: 6px; padding: 10px 15px; display: flex; align-items: center; justify-content: space-between;
    }
    .artist-card .controls { display: flex; gap: 8px; align-items: center; }
    .btn-icon { background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 16px; }
    .btn-icon:hover { color: #f8fafc; }
    .btn-remove { color: #ef4444; }
    
    .btn-main { width: 100%; padding: 14px; background: #e75b37; color: white; border: none; border-radius: 6px; font-weight: bold; font-size: 16px; cursor: pointer; margin-top: 20px; }
    .btn-main:hover { background: #d04825; }
    .btn-secondary { background: #475569; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
    .btn-secondary:hover { background: #334155; }
    .box-sub { background: #0f172a; padding: 15px; border-radius: 6px; border: 1px dashed #334155; margin-top: 10px; }

    /* Modal de Invitaciones */
    .modal-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8);
      display: none; justify-content: center; align-items: center; z-index: 1000;
    }
    .modal-content {
      background: #1e293b; padding: 30px; border-radius: 12px; max-width: 500px; width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .modal-header { font-size: 18px; font-weight: bold; color: #38bdf8; margin-bottom: 15px; border-bottom: 1px solid #334155; padding-bottom: 10px; }
    .invite-list { list-style: none; padding: 0; margin: 15px 0; }
    .invite-item { background: #0f172a; padding: 10px 15px; border-radius: 6px; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; font-size: 14px; }
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
  </style>
</head>
<body>

<div class="form-container">
  <!-- CABECERA CON BOTÓN VOLVER -->
  <div class="form-header">
    <h2><i class="fas fa-calendar-plus"></i> Crear Nuevo Evento</h2>
    <a href="/panel" class="btn-back"><i class="fas fa-arrow-left"></i> Volver al Panel</a>
  </div>

  <form action="/api/events/create" method="POST" enctype="multipart/form-data" id="eventForm">
    
    <!-- 1. NOMBRE DEL EVENTO -->
    <div class="form-group">
      <label>Nombre del Evento</label>
      <input type="text" id="nombreInput" name="nombre" placeholder="Ej: Noche de Rock & Blues" required>
    </div>

    <!-- 🖼️ FLYER DEL EVENTO (OPCIONAL WITH FALLBACK) -->
    <div class="form-group">
      <label><i class="fas fa-image" style="color: #38bdf8;"></i> Flyer Promocional del Evento (Opcional)</label>
      <input type="file" name="flyerFile" accept="image/*">
      <small style="color: #94a3b8; font-size: 12px; display: block; margin-top: 5px;">
        * Si no adjuntas un flyer, el evento se publicará utilizando la imagen de perfil/logo del organizador.
      </small>
    </div>

    <!-- 2. CUÁNDO (FECHA Y HORA) -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
      <div class="form-group">
        <label>Fecha del Evento</label>
        <input type="date" name="fecha" id="fechaEventoInput" required onchange="recalcularLimitesPreventa()">
      </div>
      <div class="form-group">
        <label>Hora de Inicio</label>
        <select name="hora" required>
          <% for(let h = 0; h < 24; h++) { %>
            <% let horaStr = (h < 10 ? '0' : '') + h; %>
            <option value="<%= horaStr %>:00"><%= horaStr %>:00 hs</option>
            <option value="<%= horaStr %>:30"><%= horaStr %>:30 hs</option>
          <% } %>
        </select>
      </div>
    </div>

    <!-- 3. QUIÉNES (ARTISTAS) -->
    <div class="form-group">
      <label>Quiénes (Artistas)</label>
      <input type="text" id="artistSearchInput" placeholder="Escribe el nombre del artista...">
      <div id="artistSuggestions" class="suggestions-list" style="display: none;"></div>

      <div class="artists-list" id="selectedArtistsContainer">
        <% if (user.role === 'Artista' && defaultArtist) { %>
          <div class="artist-card" data-id="<%= defaultArtist._id %>" data-nombre="<%= defaultArtist.nombre %>" data-owner="true">
            <span><i class="fas fa-star" style="color: #f1c40f;"></i> <strong><%= defaultArtist.nombre %></strong> (Organizador)</span>
            <input type="hidden" name="artistasIds" value="<%= defaultArtist._id %>">
            <span style="font-size: 12px; color: #64748b;">(Creador)</span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- 4. DÓNDE (ESTABLECIMIENTO O DIRECCIÓN MAPS) -->
    <div class="form-group">
      <label>Dónde (Establecimiento / Lugar)</label>

      <% if (user.role === 'Establecimiento' && defaultPlace) { %>
        <input type="hidden" name="establecimientoId" id="selectedPlaceId" value="<%= defaultPlace._id %>">
        <div class="box-sub" style="border-style: solid; border-color: #38bdf8;">
          <span>Lugar Confirmado: <strong id="placeNameDisplay"><%= defaultPlace.nombre %></strong> (Tu Establecimiento)</span>
        </div>
      <% } else { %>
        <input type="text" id="placeSearchInput" placeholder="Buscar establecimiento registrado en toc.ar...">
        <div id="placeSuggestions" class="suggestions-list" style="display: none;"></div>

        <input type="hidden" name="establecimientoId" id="selectedPlaceId" value="">

        <div id="placeSelectedBox" class="box-sub" style="display:none;">
          <span>Lugar Seleccionado: <strong id="placeNameDisplay"></strong></span>
          <button type="button" class="btn-icon btn-remove" style="float: right;" onclick="limpiarLugar()"><i class="fas fa-times"></i></button>
        </div>

        <div id="manualAddressBox" style="margin-top: 15px;">
          <label style="font-size: 12px; color: #38bdf8;">Dirección Física (Si no usas un local registrado):</label>
          <input type="text" id="direccionManualInput" name="direccionManual" placeholder="Escribe una dirección (ej: Av. Roca 1234, General Roca)...">
          <input type="hidden" name="manualLat" id="manualLat">
          <input type="hidden" name="manualLng" id="manualLng">
        </div>
      <% } %>
    </div>

    <!-- 5. TIPO DE ENTRADA -->
    <div class="form-group">
      <label>Tipo de Entrada</label>
      <select name="tipoEntrada" id="tipoEntradaSelect" onchange="actualizarCamposEntrada()">
        <option value="Entrada Gratis">Entrada Gratis</option>
        <option value="Link Externo">Link Externo</option>
        <option value="Compra Online">Compra Online (toc.ar)</option>
      </select>
    </div>

    <div id="boxLinkExterno" class="form-group" style="display: none;">
      <label>URL de Venta Externa</label>
      <input type="text" name="linkExterno" placeholder="https://tuentrada.com/evento">
    </div>

    <div id="boxCompraOnline" class="box-sub" style="display: none; margin-bottom: 20px;">
      <div class="form-group">
        <label>Precio de la Entrada ($)</label>
        <input type="number" name="precioEntrada" min="0" placeholder="Ej: 3000">
      </div>
      <div class="form-group">
        <label>Preventa Habilitada</label>
        <select name="preventaHabilitada" id="preventaSelect" onchange="toggleFechaPreventa()">
          <option value="true">Sí, habilitada inmediatamente</option>
          <option value="false">No, se habilitará en una fecha específica</option>
        </select>
      </div>

      <div class="form-group" id="boxFechaPreventa" style="display: none;">
        <label>Fecha de Inicio de Preventa</label>
        <input type="date" name="fechaInicioPreventa" id="fechaPreventaInput">
        <small style="color: #94a3b8; font-size: 11px; display: block; margin-top: 4px;">
          * Debe ser entre hoy y el día anterior al evento.
        </small>
      </div>
    </div>

    <button type="button" class="btn-main" onclick="abrirModalInvitaciones()">Crear Evento</button>
  </form>
</div>

<!-- MODAL DE CONFIRMACIÓN / INVITACIONES -->
<div class="modal-overlay" id="invitacionesModal">
  <div class="modal-content">
    <div class="modal-header">
      <i class="fas fa-paper-plane"></i> Confirmar Evento
    </div>
    <p style="font-size: 14px; color: #94a3b8; margin-bottom: 10px;" id="modalDescText">
      Revisa los detalles antes de publicar:
    </p>

    <ul class="invite-list" id="modalInviteList"></ul>

    <div class="modal-actions">
      <button type="button" class="btn-secondary" onclick="cerrarModal()">Seguir Editando</button>
      <button type="button" class="btn-main" style="width: auto; margin:0;" onclick="confirmarYEnviar()">Confirmar y Guardar</button>
    </div>
  </div>
</div>

<script>
  const userRole = '<%= user.role %>';
  const currentArtistProfileId = '<%= user.artistProfile ? user.artistProfile.toString() : "" %>';

  function abrirModalInvitaciones() {
    const form = document.getElementById('eventForm');
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const artistCards = document.querySelectorAll('.artist-card');
    let listaArtistasValidos = [];

    artistCards.forEach(card => {
      const artId = card.getAttribute('data-id');
      const artNombre = card.getAttribute('data-nombre');
      if (artId) listaArtistasValidos.push({ id: artId, nombre: artNombre });
    });

    if (userRole === 'Establecimiento' && listaArtistasValidos.length === 0) {
      alert('Debes agregar al menos un artista a la lista para finalizar la creación del evento.');
      document.getElementById('artistSearchInput').focus();
      return;
    }

    const modalList = document.getElementById('modalInviteList');
    modalList.innerHTML = '';
    let destinatarios = 0;

    artistCards.forEach(card => {
      const artId = card.getAttribute('data-id');
      const artNombre = card.getAttribute('data-nombre');

      if (userRole === 'Artista' && artId === currentArtistProfileId) {
        // Creador no recibe invitación
      } else {
        destinatarios++;
        const li = document.createElement('li');
        li.className = 'invite-item';
        li.innerHTML = `<i class="fas fa-user-tag" style="color: #38bdf8;"></i> <span><strong>${artNombre}</strong> (Artista Invitado)</span>`;
        modalList.appendChild(li);
      }
    });

    const selectedPlaceIdInput = document.getElementById('selectedPlaceId');
    const selectedPlaceId = selectedPlaceIdInput ? selectedPlaceIdInput.value : '';
    const placeNameDisplay = document.getElementById('placeNameDisplay');
    const placeName = placeNameDisplay ? placeNameDisplay.innerText : '';

    if (selectedPlaceId && userRole !== 'Establecimiento') {
      destinatarios++;
      const li = document.createElement('li');
      li.className = 'invite-item';
      li.innerHTML = `<i class="fas fa-building" style="color: #f1c40f;"></i> <span><strong>${placeName}</strong> (Establecimiento Anfitrión)</span>`;
      modalList.appendChild(li);
    }

    // SI NO HAY TERCEROS INVITADOS, EL EVENTO SE PUBLICA DIRECTAMENTE
    const descText = document.getElementById('modalDescText');
    if (destinatarios === 0) {
      descText.innerHTML = 'El evento no contiene invitados pendientes y se <strong>publicará de inmediato</strong>:';
      const li = document.createElement('li');
      li.className = 'invite-item';
      li.innerHTML = `<i class="fas fa-check-circle" style="color: #4ade80;"></i> <span>Publicación directa instantánea en la agenda de toc.ar.</span>`;
      modalList.appendChild(li);
    } else {
      descText.innerHTML = 'El evento quedará en estado <strong>Pendiente</strong> y enviará invitaciones a:';
    }

    document.getElementById('invitacionesModal').style.display = 'flex';
  }

  function cerrarModal() {
    document.getElementById('invitacionesModal').style.display = 'none';
  }

  function confirmarYEnviar() {
    document.getElementById('eventForm').submit();
  }

  // Google Maps Autocomplete seguro
  let autocompleteAddress;
  function initMapsAutocomplete() {
    const input = document.getElementById('direccionManualInput');
    if (!input) return;

    if (typeof google === 'undefined' || !google.maps || !google.maps.places) {
      return;
    }

    try {
      autocompleteAddress = new google.maps.places.Autocomplete(input, {
        types: ['address'],
        componentRestrictions: { country: 'ar' }
      });

      autocompleteAddress.addListener('place_changed', () => {
        const place = autocompleteAddress.getPlace();
        if (place.geometry && place.geometry.location) {
          document.getElementById('manualLat').value = place.geometry.location.lat();
          document.getElementById('manualLng').value = place.geometry.location.lng();
        }
      });
    } catch (e) {
      console.warn('Autocomplete no disponible:', e);
    }
  }
  window.addEventListener('load', initMapsAutocomplete);

  // Búsqueda AJAX de Artistas
  const artistInput = document.getElementById('artistSearchInput');
  const artistSuggestions = document.getElementById('artistSuggestions');
  const selectedArtistsContainer = document.getElementById('selectedArtistsContainer');

  artistInput.addEventListener('input', async () => {
    const q = artistInput.value.trim();
    if (q.length < 2) { artistSuggestions.style.display = 'none'; return; }
    
    const res = await fetch(`/api/artists/search?q=${encodeURIComponent(q)}`);
    const data = await res.json();

    artistSuggestions.innerHTML = '';
    if (data.length > 0) {
      data.forEach(art => {
        const item = document.createElement('div');
        item.className = 'suggestion-item';
        item.innerHTML = `<i class="fas fa-music"></i> <span>${art.nombre}</span>`;
        item.onclick = () => agregarArtista(art._id, art.nombre);
        artistSuggestions.appendChild(item);
      });
      artistSuggestions.style.display = 'block';
    } else {
      artistSuggestions.style.display = 'none';
    }
  });

  function agregarArtista(id, nombre) {
    artistSuggestions.style.display = 'none';
    artistInput.value = '';

    if (document.querySelector(`.artist-card[data-id="${id}"]`)) return;

    const card = document.createElement('div');
    card.className = 'artist-card';
    card.setAttribute('data-id', id);
    card.setAttribute('data-nombre', nombre);
    card.innerHTML = `
      <span><i class="fas fa-grip-lines"></i> <strong>${nombre}</strong></span>
      <input type="hidden" name="artistasIds" value="${id}">
      <div class="controls">
        <button type="button" class="btn-icon" onclick="moverArtista(this, -1)"><i class="fas fa-arrow-up"></i></button>
        <button type="button" class="btn-icon" onclick="moverArtista(this, 1)"><i class="fas fa-arrow-down"></i></button>
        <button type="button" class="btn-icon btn-remove" onclick="this.closest('.artist-card').remove()"><i class="fas fa-times"></i></button>
      </div>
    `;
    selectedArtistsContainer.appendChild(card);
  }

  function moverArtista(btn, direccion) {
    const card = btn.closest('.artist-card');
    if (direccion === -1 && card.previousElementSibling) {
      if (card.previousElementSibling.querySelector('input[name="artistasIds"]')) {
        selectedArtistsContainer.insertBefore(card, card.previousElementSibling);
      }
    } else if (direccion === 1 && card.nextElementSibling) {
      selectedArtistsContainer.insertBefore(card.nextElementSibling, card);
    }
  }

  // Búsqueda AJAX de Establecimientos
  const placeInput = document.getElementById('placeSearchInput');
  const placeSuggestions = document.getElementById('placeSuggestions');
  const selectedPlaceId = document.getElementById('selectedPlaceId');
  const placeSelectedBox = document.getElementById('placeSelectedBox');
  const placeNameDisplay = document.getElementById('placeNameDisplay');

  if (placeInput) {
    placeInput.addEventListener('input', async () => {
      const q = placeInput.value.trim();
      if (q.length < 2) { placeSuggestions.style.display = 'none'; return; }

      const res = await fetch(`/api/places/search?q=${encodeURIComponent(q)}`);
      const data = await res.json();

      placeSuggestions.innerHTML = '';
      if (data.length > 0) {
        data.forEach(p => {
          const item = document.createElement('div');
          item.className = 'suggestion-item';
          item.innerHTML = `<i class="fas fa-building"></i> <span>${p.nombre}</span>`;
          item.onclick = () => seleccionarLugar(p._id, p.nombre, p.direccionTexto);
          placeSuggestions.appendChild(item);
        });
        placeSuggestions.style.display = 'block';
      } else {
        placeSuggestions.style.display = 'none';
      }
    });
  }

  function seleccionarLugar(id, nombre, direccionTexto = '') {
    placeSuggestions.style.display = 'none';
    placeInput.value = '';
    selectedPlaceId.value = id;
    placeNameDisplay.innerText = nombre;
    placeSelectedBox.style.display = 'block';

    const addressInput = document.getElementById('direccionManualInput');
    if (addressInput) {
      addressInput.value = direccionTexto || `${nombre}, Alto Valle`;
      addressInput.disabled = true;
    }
  }

  function limpiarLugar() {
    selectedPlaceId.value = '';
    placeSelectedBox.style.display = 'none';
    const addressInput = document.getElementById('direccionManualInput');
    if (addressInput) {
      addressInput.value = '';
      addressInput.disabled = false;
    }
  }

  function recalcularLimitesPreventa() {
    const fechaEventoStr = document.getElementById('fechaEventoInput').value;
    const fechaPreventaInput = document.getElementById('fechaPreventaInput');
    if (!fechaEventoStr) return;

    const hoy = new Date();
    const hoyISO = hoy.toISOString().split('T')[0];

    const dateEvento = new Date(fechaEventoStr);
    dateEvento.setDate(dateEvento.getDate() - 1);
    const maxPreventaISO = dateEvento.toISOString().split('T')[0];

    fechaPreventaInput.min = hoyISO;
    fechaPreventaInput.max = maxPreventaISO;
  }

  function actualizarCamposEntrada() {
    const val = document.getElementById('tipoEntradaSelect').value;
    document.getElementById('boxLinkExterno').style.display = (val === 'Link Externo') ? 'block' : 'none';
    document.getElementById('boxCompraOnline').style.display = (val === 'Compra Online') ? 'block' : 'none';
  }

  function toggleFechaPreventa() {
    const val = document.getElementById('preventaSelect').value;
    const box = document.getElementById('boxFechaPreventa');
    box.style.display = (val === 'false') ? 'block' : 'none';
    if (val === 'false') recalcularLimitesPreventa();
  }
</script>

</body>
</html>